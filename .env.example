# Database
DATABASE_URL=postgresql://incite:incite@db:5432/incite

# Chroma — embedded (PersistentClient), writes to a local directory
CHROMA_PERSIST_PATH=/app/chroma_data

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# RAG config
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Hybrid retrieval (Phase 4).
# RETRIEVAL_MODE: "vector" = vector-only (default, backward compatible)
#                 "hybrid" = BM25 + vector + Reciprocal Rank Fusion
# BM25_RRF_K: RRF constant (60 is the TREC standard; higher = less top-rank bias)
RETRIEVAL_MODE=vector
BM25_RRF_K=60

# LLM
GOOGLE_API_KEY=your_key_here
LLM_MODEL=gemini-3-flash-preview
LLM_FALLBACK_MODELS=gemini-flash-latest,gemini-2.5-flash-lite

# Storage
UPLOAD_DIR=/app/uploads

# Upload validation limits
# MAX_UPLOAD_SIZE_MB: reject files larger than this before processing (default 20)
# MAX_PDF_PAGES: reject PDFs with more pages than this (default 800)
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=800

# CORS — comma-separated allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173
