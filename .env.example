# Database
DATABASE_URL=postgresql://incite:incite@db:5432/incite

# Chroma — embedded (PersistentClient), writes to a local directory
CHROMA_PERSIST_PATH=/app/chroma_data

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# RAG config
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Hybrid retrieval (Phase 4).
# RETRIEVAL_MODE: "hybrid" = BM25 + vector + Reciprocal Rank Fusion (default)
#                 "vector" = vector-only
#                 "hybrid_rerank" = hybrid retrieval followed by CrossEncoder reranking
# Values are case-insensitive. Blank or unsupported values prevent startup.
# BM25_RRF_K: RRF constant (60 is the TREC standard; higher = less top-rank bias)
RETRIEVAL_MODE=hybrid
BM25_RRF_K=60

# LLM — Groq provider (https://console.groq.com)
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# Storage
UPLOAD_DIR=/app/uploads

# Upload validation limits
# MAX_UPLOAD_SIZE_MB: reject files larger than this before processing (default 20)
# MAX_PDF_PAGES: reject PDFs with more pages than this (default 800)
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=800

# CORS — comma-separated allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173
